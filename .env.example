# Server Settings
PORT=80
DB_PATH=elearning.db
AUTO_OPEN_BROWSER=true

# Ethereum / EVM Testnet (Sepolia / Polygon Amoy)
# Leave empty to run in built-in mock simulation mode
ETH_RPC_URL=https://rpc.sepolia.org
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
MINTER_PRIVATE_KEY=your_private_key_without_0x

# SMTP Email Notification Settings
# Leave empty to log simulated email notifications to console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="LearnChain Protocol <noreply@learnchain.io>"

# Decentralized Storage
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Auto-Update Settings (Optional)
# GitHub repository in "owner/repo" format for checking GitHub Releases
UPDATE_REPO=
# Optional custom JSON manifest URL (overrides UPDATE_REPO if set)
UPDATE_MANIFEST_URL=
